# Copy to .env and fill in. Never commit .env.

# --- LLM (Groq) -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Memory (Hindsight) -----------------------------------------------------
# Self-hosted server by default. For Hindsight Cloud use
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io and set HINDSIGHT_API_KEY.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=munshi-rao-associates

# Used by the self-hosted hindsight-api server itself (fact extraction, reflect).
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=

# --- App --------------------------------------------------------------------
DB_PATH=data/munshi.db
DATA_DIR=data/generated
